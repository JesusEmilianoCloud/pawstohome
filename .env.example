# ========== CONFIGURACIÓN GENERAL ==========
DEBUG=True
SECRET_KEY=your-secret-key-here
SITE_ID=1

# ========== BASE DE DATOS ==========
DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/pawstohome

# ========== CLOUDFLARE R2 STORAGE ==========
# Habilitar Cloudflare R2 (true/false)
USE_CLOUDFLARE_R2=false

# Credenciales de Cloudflare R2 (obtenidas del dashboard de Cloudflare)
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Configuración del bucket
CLOUDFLARE_R2_BUCKET_NAME=pawstohome-media
CLOUDFLARE_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Dominio personalizado (opcional - recomendado para producción)
# Si tienes un dominio personalizado configurado en Cloudflare R2:
CLOUDFLARE_R2_CUSTOM_DOMAIN=media.tudominio.com

# ========== AUTENTICACIÓN SOCIAL ==========
# Google OAuth (opcional)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ========== EMAIL ==========
# Configuración de email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password